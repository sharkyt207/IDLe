{
  "name": "scrap-empire",
  "version": "0.1.0",
  "private": true,
  "description": "Scrap Empire - Idle/Tycoon Prototyp (GDD Kapitel 1 & 2)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "simulate": "node scripts/simulate.mjs",
    "test": "node tests/run.mjs",
    "i18n": "node scripts/i18n-check.mjs",
    "check": "npm run typecheck && npm run simulate -- 30 && npm test"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "playwright": "^1.49.0"
  }
}
